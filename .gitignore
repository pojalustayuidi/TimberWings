# This .gitignore should be placed at the root of your Unity project directory
# https://github.com/github/gitignore/blob/main/Unity.gitignore

/[Ll]ibrary/
/[Tt]emp/
/[Oo]bj/
/[Bb]uild/
/[Bb]uilds/
/[Ll]ogs/
/[Uu]serSettings/

# MemoryCaptures can get excessive large.
/[Mm]emoryCaptures/

# Asset server cache folder
/[Aa]ssetServerCache/

# Autogenerated and cached file icr
/[Rr]eferences/

# Visual Studio cache directory
.vs/
.vsconfig

# Gradle cache directory
.gradle/

# Autogenerated VS/MD/JetBrains project files
ExportedObj/
.consulo/
*.csproj
*.unityproj
*.sln
*.suo
*.tmp
*.user
*.userprefs
*.pidb
*.booproj
*.svd
*.pdb
*.mdb
*.opendb
*.VC.db

# Unity 3D generated meta files
*.pidb.meta
*.mdb.meta

# Unity Generated Go Mono
Data/

# Autogenerated asset database
*/[Aa]ssets/[Aa]ssetVersioning.db
*/[Aa]ssets/[Aa]ssetVersioning.db.meta
*/[Aa]ssets/[Oo]verride/

# Autogenerated CS proj files
*.slnx

# Ignorable custom folders that shouldn't go to git
/Screenshots/
/VoiceExport/
/build3/