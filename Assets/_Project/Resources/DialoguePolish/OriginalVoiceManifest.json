      "chapter": "3 Прокачка",
      "actingDirection": "оживлённо, делится секретом",
      "voiceUsed": "Kore"
    },
    {
      "id": "leo_ba6b6af4",
      "file": "leo_ba6b6af4.wav",
      "character": "Лео",
      "text": "И что улучшать первым?",
