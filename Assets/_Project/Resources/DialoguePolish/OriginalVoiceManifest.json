      "chapter": "1 Вступление",
      "actingDirection": "хитро, подбадривает",
      "voiceUsed": "Kore"
    },
    {
      "id": "leo_f329d32e",
      "file": "leo_f329d32e.wav",
      "character": "Лео",
      "text": "Договорились. Две ходки.",
