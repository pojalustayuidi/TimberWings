      "chapter": "1 Вступление",
      "actingDirection": "с улыбкой, согласен",
      "voiceUsed": "Puck"
    },
    {
      "id": "mira_2621e08e",
      "file": "mira_2621e08e.wav",
      "character": "Мира",
      "text": "Вот это разговор! Принесёшь дров, поговорим дальше.",
      "trigger": "Подошёл к Мире (E)",
      "chapter": "1 Вступление",
      "actingDirection": "довольно, подбадривает",
      "voiceUsed": "Kore"
    },
    {
      "id": "mira_1fa5ec5d",
      "file": "mira_1fa5ec5d.wav",
      "character": "Мира",
      "text": "Горит! Впервые за три дня в лагере тепло.",
      "trigger": "Костёр горит, вернулся к Мире",
      "chapter": "1 Вступление",
      "actingDirection": "тепло, с облегчением",
      "voiceUsed": "Kore"
    },
    {
      "id": "leo_6e16771b",
      "file": "leo_6e16771b.wav",
      "character": "Лео",
      "text": "Дядя бы гордился... Что дальше?",
