      "actingDirection": "заинтересованно",
      "voiceUsed": "Puck"
    },
    {
      "id": "mira_58311756",
      "file": "mira_58311756.wav",
      "character": "Мира",
      "text": "О прокачке. Я открыла тебе окно, монеты за уровень уже в кармане.",
