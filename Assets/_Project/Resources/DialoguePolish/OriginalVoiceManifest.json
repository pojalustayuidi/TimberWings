      "chapter": "1 Вступление",
      "actingDirection": "тепло и по-хозяйски, ставит первую задачу",
      "voiceUsed": "Kore"
    },
    {
      "id": "leo_29da6c4d",
      "file": "leo_29da6c4d.wav",
      "character": "Лео",
      "text": "Дрова так дрова. Топор при мне, берусь.",
