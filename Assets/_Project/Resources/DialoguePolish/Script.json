{
  "version": 2,
  "scenes": [
    {
      "id": "prologue",
      "title": "Приезд Лео",
      "npc": "Лео",
      "lines": [
        {
          "hero": true,
          "text": "Дядя? ...Никого. Ладно, осмотрюсь.",
          "priority": 2,
          "direction": "Тихо себе под нос, растерянно, без паники"
        }
      ]
    },
    {
      "id": "intro_task",
      "title": "Первый разговор с Мирой",
      "npc": "Мира",
      "lines": [
        {
          "hero": false,
          "text": "О, новенький! Ты ведь племянник Гуннара? Лео, да?",
          "priority": 2,
          "direction": "Тёплое удивление, узнаёт гостя"
        },
        {
          "hero": true,
          "text": "Да. Он писал, что нужна помощь. Где он?",
          "priority": 2,
          "direction": "Вопрос прямой, с настоящим беспокойством"
        },
        {
          "hero": false,
          "text": "Пропал три дня назад. А мост к его мастерской шторм разнёс в щепки.",
          "priority": 2,
          "direction": "Чуть тише и серьёзнее, без трагического надрыва"
        },
        {
          "hero": true,
          "text": "Значит, будем строить новый. С чего начать?",
          "priority": 2,
          "direction": "Собрался, отвечает решительно"
        },
        {
          "hero": false,
          "text": "С огня. Нарубай дров и разожги костёр на каменном круге. Там сердце лагеря.",
          "priority": 2,
          "direction": "Спокойно, ободряюще, ясно произнести задачу"
        },
        {
          "hero": true,
          "text": "Дрова так дрова. Топор при мне, берусь.",
          "priority": 2,
          "direction": "Лёгкая улыбка, согласие"
        }
      ]
    },
    {
      "id": "intro_reward",
      "title": "Костёр горит, нужны припасы",
      "npc": "Мира",
      "lines": [
        {
          "hero": false,
          "text": "Горит! Впервые за три дня в лагере тепло.",
          "priority": 2,
          "direction": "Искренняя радость с облегчением"
        },
        {
          "hero": true,
          "text": "Дядя бы гордился... Что дальше?",
          "priority": 2,
          "direction": "На миг тихо и грустно, затем собраться"
        },
        {
          "hero": false,
          "text": "Теперь про запас. Принеси мне восемь брёвен, пригодятся на холода.",
          "priority": 2,
          "direction": "Забота о лагере, по-деловому"
        },
        {
          "hero": true,
          "text": "Восемь? Рюкзак вмещает только четыре.",
          "priority": 2,
          "direction": "Лёгкое удивление, не жалоба"
        },
        {
          "hero": false,
          "text": "Приноси по четыре. Подойди ко мне с дровами и нажми E — приму обе ходки.",
          "priority": 2,
          "direction": "Очень понятно, доброжелательно"
        }
      ]
    },
    {
      "id": "upgrade_offer",
      "title": "Улучшение рюкзака",
      "npc": "Мира",
      "lines": [
        {
          "hero": false,
          "text": "Второй уровень! Вот теперь можно говорить о настоящем деле.",
          "priority": 2,
          "direction": "Ободряюще, с улыбкой"
        },
        {
          "hero": true,
          "text": "Надеюсь, речь про рюкзак. У меня плечи уже знают каждое дерево.",
          "priority": 2,
          "direction": "Сухая добрая шутка, устало"
        },
        {
          "hero": false,
          "text": "Угадал. Открой «Прокачку» на U и увеличь вместимость. Монет на первое улучшение хватит.",
          "priority": 2,
          "direction": "Коротко и чётко, не как диктор туториала"
        },
        {
          "hero": true,
          "text": "Окно на U. Берусь.",
          "priority": 2,
          "direction": "Короткое уверенное согласие"
        }
      ]
    },
    {
      "id": "upgrade_report",
      "title": "К Оскару",
      "npc": "Мира",
      "lines": [
        {
          "hero": false,
          "text": "Шесть брёвен за рейс, совсем другое дело! Топор и ноги подкачаешь позже.",
          "priority": 2,
          "direction": "Довольна результатом"
        },
        {
          "hero": false,
          "text": "К Оскару, он у хижины, где брёвна лежат. Друг Гуннара, доски делать умеет.",
          "priority": 2,
          "direction": "Тепло, с уважением к другу"
        },
        {
          "hero": true,
          "text": "Может, он знает, зачем дядя рисовал крылья на полях писем?",
          "priority": 2,
          "direction": "Впервые появляется любопытство и тревога"
        }
      ]
    },
    {
      "id": "hut_offer",
      "title": "Ремонт хижины",
      "npc": "Оскар",
      "lines": [
        {
          "hero": false,
          "text": "Гуннаров племянник? Вылитый дядя, даже хмуришься так же.",
          "priority": 2,
          "direction": "Улыбка старого мастера, чуть грубовато, но тепло"
        },
        {
          "hero": true,
          "text": "Вы Оскар? Мира сказала, вы научите делать доски.",
          "priority": 2,
          "direction": "Вежливо и по делу"
        },
        {
          "hero": false,
          "text": "Научу. Но пила стоит в хижине, а крыша там как решето. Сначала чиним.",
          "priority": 2,
          "direction": "Мастер ворчит о состоянии крыши"
        },
        {
          "hero": true,
          "text": "Сколько нужно брёвен?",
          "priority": 2,
          "direction": "Деловито"
        },
        {
          "hero": false,
          "text": "Десять на стены, десять на крышу. Топор не обманет, как говорил Гуннар.",
          "priority": 2,
          "direction": "Уверенно, с тёплой памятью"
        },
        {
          "hero": true,
          "text": "Понял. Несу брёвна.",
          "priority": 2,
          "direction": "Кратко"
        }
      ]
    },
    {
      "id": "hut_report",
      "title": "Пила и чертежи",
      "npc": "Оскар",
      "lines": [
        {
          "hero": false,
          "text": "Стоит и не скрипит! Гуннар бы кивнул.",
          "priority": 2,
          "direction": "Гордость мастера"
        },
        {
          "hero": true,
          "text": "Дядя тоже начинал с такой хижины?",
          "priority": 2,
          "direction": "Узнаёт о прошлом дяди"
        },
        {
          "hero": false,
          "text": "С неё. Потом на каждом клочке бумаги рисовал крылья. Будто уже видел их готовыми.",
          "priority": 2,
          "direction": "Чуть задумчивее, тихий намёк на загадку"
        },
        {
          "hero": false,
          "text": "Работает. Клади брёвна на верстак, потом забирай доски. Два бревна дают одну.",
          "priority": 2,
          "direction": "Практично, объясняет работу пилы"
        },
        {
          "hero": false,
          "text": "Мира без них лавку не поставит. Шести ей хватит для начала.",
          "priority": 2,
          "direction": "Деловито"
        },
        {
          "hero": true,
          "text": "Шесть так шесть. Займусь.",
          "priority": 2,
          "direction": "Лёгкая улыбка, рабочий настрой"
        }
      ]
    },
    {
      "id": "market_offer",
      "title": "Лавка для Рико",
      "npc": "Мира",
      "lines": [
        {
          "hero": false,
          "text": "Доски! Настоящие! Ну-ка, дай посмотреть.",
          "priority": 2,
          "direction": "Удивлённая радость, коротко"
        },
        {
          "hero": true,
          "text": "Оскар сказал, они нужны для прилавка.",
          "priority": 2,
          "direction": "Спокойно"
        },
        {
          "hero": false,
          "text": "Поставим лавку для Рико: помост, стойки и крышу. Материалы сдавай прямо на стройку.",
          "priority": 2,
          "direction": "Упомянуть Рико как знакомого лагерю"
        },
        {
          "hero": true,
          "text": "Рико? Надеюсь, он хотя бы честно считает.",
          "priority": 2,
          "direction": "С любопытством, подшучивает"
        }
      ]
    },
    {
      "id": "market_report",
      "title": "Лавка готова",
      "npc": "Мира",
      "lines": [
        {
          "hero": false,
          "text": "Лавка готова! Рико уже у прилавка. Подойди к нему и нажми E, чтобы продать ресурсы.",
          "priority": 2,
          "direction": "Радостно, короткая полезная информация"
        },
        {
          "hero": true,
          "text": "Пойду знакомиться. Он, кажется, уже пересчитал все мои брёвна.",
          "priority": 2,
          "direction": "Улыбка, наблюдательность"
        }
      ]
    },
    {
      "id": "merchant_intro",
      "title": "Знакомство с Рико",
      "npc": "Рико",
      "lines": [
        {
          "hero": false,
          "text": "О! Племянник Гуннара! Я Рико. Добро пожаловать в самую честную лавку этого берега.",
          "priority": 2,
          "direction": "Быстро, дружелюбно, гордится лавкой"
        },
        {
          "hero": true,
          "text": "Единственную лавку этого берега?",
          "priority": 2,
          "direction": "Сдержанный сарказм"
        },
        {
          "hero": false,
          "text": "Вот именно! Беру брёвна и доски. Цены увидишь у прилавка, нажми E.",
          "priority": 2,
          "direction": "Пауза после «именно», деловой азарт"
        },
        {
          "hero": true,
          "text": "А если продам все доски? На мост ведь не останется.",
          "priority": 2,
          "direction": "Проверяет торговца"
        },
        {
          "hero": false,
          "text": "Молодец, думаешь. Оставь запас на стройку. Монеты тоже понадобятся — за мост никто не заплатит.",
          "priority": 2,
          "direction": "Искренний совет, понижает тон"
        },
        {
          "hero": true,
          "text": "Ладно, господин честный торговец. Давай посмотрим на цены.",
          "priority": 2,
          "direction": "С улыбкой, без злости"
        }
      ]
    },
    {
      "id": "tent_offer",
      "title": "Возвращение артели",
      "npc": "Оскар",
      "lines": [
        {
          "hero": false,
          "text": "Лавка работает, монеты пошли. Теперь вернём людей.",
          "priority": 2,
          "direction": "Деловито, удовлетворён"
        },
        {
          "hero": true,
          "text": "Они все ушли после шторма?",
          "priority": 2,
          "direction": "Искренний вопрос"
        },
        {
          "hero": false,
          "text": "Разбрелись. Починим артель — будет где работать и хранить доски.",
          "priority": 2,
          "direction": "Тёплая грусть, затем дело"
        },
        {
          "hero": true,
          "text": "Значит, мы не просто строим лагерь. Мы собираем людей обратно.",
          "priority": 2,
          "direction": "Осознание важности работы"
        },
        {
          "hero": false,
          "text": "Вот теперь правильно сказал. Материалы и монеты — у стройки. Начинай.",
          "priority": 2,
          "direction": "Одобрение мастера"
        }
      ]
    },
    {
      "id": "tent_report",
      "title": "Артель готова",
      "npc": "Оскар",
      "lines": [
        {
          "hero": false,
          "text": "Слышишь? Пила работает, лагерь оживает. Гуннар бы сейчас улыбнулся.",
          "priority": 2,
          "direction": "Доволен, чуть растроган"
        },
        {
          "hero": true,
          "text": "А мне что делать, когда рабочие всё заполнят?",
          "priority": 2,
          "direction": "Практичный вопрос"
        },
        {
          "hero": false,
          "text": "За складом следить. Заполнится — работа встанет. Забирай запас или продавай Рико.",
          "priority": 2,
          "direction": "Спокойное объяснение"
        },
        {
          "hero": true,
          "text": "Понял. Значит, теперь мы команда.",
          "priority": 2,
          "direction": "Уверенно"
        }
      ]
    },
    {
      "id": "pets_offer",
      "title": "Первый попутчик",
      "npc": "Оскар",
      "lines": [
        {
          "hero": false,
          "text": "Гуннар оставил у артели лесную клеть. Первую можно открыть бесплатно.",
          "priority": 2,
          "direction": "Спокойно, с теплом"
        },
        {
          "hero": true,
          "text": "Он и зверей в свой большой план записал?",
          "priority": 2,
          "direction": "Удивлённая улыбка"
        },
        {
          "hero": false,
          "text": "Говорил: хорошему делу нужен попутчик. Открой клеть и выбери питомца в активный слот.",
          "priority": 2,
          "direction": "Чётко произнести действие"
        }
      ]
    },
    {
      "id": "pets_report",
      "title": "Попутчик рядом",
      "npc": "Оскар",
      "lines": [
        {
          "hero": false,
          "text": "Вот и попутчик. Теперь по лесу хотя бы не одному ходить.",
          "priority": 2,
          "direction": "Доброе одобрение"
        },
        {
          "hero": true,
          "text": "Надеюсь, он не потребует зарплату, как Рико.",
          "priority": 2,
          "direction": "Тихо шутит"
        },
        {
          "hero": false,
          "text": "Накорми вовремя — и поладите. А нам пора к мосту.",
          "priority": 2,
          "direction": "Дружелюбно, перейти к делу"
        }
      ]
    },
    {
      "id": "bridge_offer",
      "title": "К мастерской Гуннара",
      "npc": "Оскар",
      "lines": [
        {
          "hero": false,
          "text": "Лагерь держится на ногах. Пора за реку — к мастерской Гуннара.",
          "priority": 2,
          "direction": "Серьёзнее обычного"
        },
        {
          "hero": true,
          "text": "Ты ведь не знаешь, что он там?",
          "priority": 2,
          "direction": "Тихое беспокойство"
        },
        {
          "hero": false,
          "text": "Не знаю. Знаю другое: перед штормом он просил не трогать старое дерево. Даже мне не объяснил зачем.",
          "priority": 2,
          "direction": "Сдержанно, загадка без пафоса"
        },
        {
          "hero": true,
          "text": "Тогда восстановим мост. С чего начнём?",
          "priority": 2,
          "direction": "Решимость"
        },
        {
          "hero": false,
          "text": "Опоры, настил, тросы. Материалы и монеты указаны на каждом этапе. А дальше — сами увидим.",
          "priority": 2,
          "direction": "Чёткие инструкции, в конце надежда"
        }
      ]
    },
    {
      "id": "bridge_ready",
      "title": "Мост готов",
      "npc": "Лео",
      "lines": [
        {
          "hero": true,
          "text": "Ну вот, дядя. Дорогу я тебе вернул. Осталось понять, куда ты ушёл.",
          "priority": 2,
          "direction": "Спокойно, с тихой решимостью"
        }
      ]
    }
  ]
}
