  miraTalk: {fileID: 0}
  campfirePoint: {fileID: 0}
  startStep: 0
  firstDelay: 0.6
  moveDistance: 3
  treesToChop: 4
  moveText: "\u041E\u0441\u043C\u043E\u0442\u0440\u0438\u0441\u044C: \u0438\u0434\u0438
    \u0441 \u043F\u043E\u043C\u043E\u0449\u044C\u044E <color=#6BCB5A>WASD</color>"
  goText: "\u041F\u043E\u0434\u043E\u0439\u0434\u0438 \u043A \u041C\u0438\u0440\u0435"
  talkText: "\u041F\u043E\u0433\u043E\u0432\u043E\u0440\u0438 \u0441 \u041C\u0438\u0440\u043E\u0439:
    <color=#6BCB5A>E</color>"
  chopLogsText: "\u041D\u0430\u0440\u0443\u0431\u0438\u0442\u044C \u0434\u0440\u043E\u0432:
    {0}/{1}"
  chopMoreText: "\u041D\u0443\u0436\u043D\u043E \u0435\u0449\u0451 \u0434\u0440\u043E\u0432:
    {0}/{1}"
  campfireText: "\u041E\u0442\u043D\u0435\u0441\u0438 \u0434\u0440\u043E\u0432\u0430
    \u043D\u0430 \u043A\u0430\u043C\u0435\u043D\u043D\u044B\u0439 \u043A\u0440\u0443\u0433
    \u0438 \u0440\u0430\u0437\u043E\u0436\u0433\u0438 \u043A\u043E\u0441\u0442\u0451\u0440"
  campfireProgressText: "\u0421\u0434\u0430\u0439 \u0434\u0440\u043E\u0432\u0430
    \u043D\u0430 \u043A\u043E\u0441\u0442\u0451\u0440: {0}/{1}"
  returnText: "\u0412\u0435\u0440\u043D\u0438\u0441\u044C \u043A \u041C\u0438\u0440\u0435:
    \u043A\u043E\u0441\u0442\u0451\u0440 \u0433\u043E\u0440\u0438\u0442"
