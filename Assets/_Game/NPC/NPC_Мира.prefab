  - speaker: 
    text: "\u0422\u044B \u0436\u0438\u0432\u043E\u0439! \u0418\u0434\u0451\u043C,
      \u043C\u043D\u0435 \u043D\u0443\u0436\u043D\u044B \u0434\u0440\u043E\u0432\u0430,
      \u0438 \u0442\u0435\u0431\u0435 \u0442\u043E\u0436\u0435 \u043D\u0443\u0436\u043D\u043E
      \u0441\u043E\u0433\u0440\u0435\u0442\u044C\u0441\u044F."
    voice: {fileID: 0}
    pauseAfter: 0.45
  - speaker: 
    text: "\u0414\u0435\u0440\u0435\u0432\u044C\u044F \u0432\u043E\u043D \u0442\u0430\u043C,
      \u0432 \u043B\u0435\u0441\u0443. \u0414\u0435\u0440\u0436\u0438 E, \u043F\u043E\u043A\u0430
      \u043D\u0435 \u0443\u043F\u0430\u0434\u0451\u0442."
    voice: {fileID: 0}
    pauseAfter: 0.45
